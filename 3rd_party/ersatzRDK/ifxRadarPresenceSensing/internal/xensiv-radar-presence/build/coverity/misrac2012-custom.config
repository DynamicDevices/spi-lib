{
    "version": "2.0",
    "standard": "misrac2012",
    "title": "MISRA C-2012 globally deviated rules",
    "deviations": [
        {
            "deviation": "Rule 3.1",
            "reason": "Required. Using of the special comment symbols is need for Doxygen comment support, it does not have any impact."
        },
        {
            "deviation": "Rule 1.2",
            "reason": "Advisory. The middleware library supports ISO:C99 standard."
        },
        {
            "deviation": "Rule 2.5",
            "reason": "Advisory. The middleware library provides API to the hardware. The macro is part of API, which is defined for application-level only."
        },
        {
            "deviation": "Rule 8.7",
            "reason": "Advisory. The middleware library provides API to the hardware. The functions and objects with external linkage are part of API, which are defined for application-level only."
        },
        {
            "deviation": "Rule 11.4",
            "reason": "Advisory. The cast from unsigned int to pointer does not have any unintended effect, as it is a consequence of the definition of a structure based on hardware registers."
        },
        {
            "deviation": "Directive 4.8",
            "reason": "Advisory. Deviated since object provided by HAL is used without dereferencing for own needs of LIN middleware."
        },
        {
            "deviation": "Directive 4.9",
            "reason": "Advisory. Deviated since function-like macros are used to allow more efficient code."
        },
        {
            "deviation": "Rule 8.13",
            "reason": "Advisory. Handler is might need to be modified."
        },
        {
            "deviation": "Rule 11.3",
            "reason": "Required. Pointer conversions are done to access underlying floating array of complex array"
        },
        {
            "deviation": "Rule 11.5",
            "reason": "Advisory. The library uses memory allocation which needs to be assigned to a certain type."
        },
        {
            "deviation": "Rule 15.5",
            "reason": "Advisory. Return statement can be used multiple times in function if it leads to clear code."
        },
        {
            "deviation": "Rule 21.3",
            "reason": "Required. Malloc and free are not bad in itself if used only during initialization. In our library the user can use its own memory allocators"
        }
    ]
}
